OPENAI_API_BASE=""
OPENAI_API_KEY=""
GLM_API_BASE=""
GLM_API_KEY=""
JINA_API_KEY=""

# A股实盘(可选):通达信桥地址与 Token(Windows 交易机,见 brokers/tdx-bridge/README.md)
# TDX_BRIDGE_URL=http://<windows-ip>:8550
# TDX_BRIDGE_TOKEN=

MATH_HTTP_PORT=8000
SEARCH_HTTP_PORT=8001
TRADE_HTTP_PORT=8002
GETPRICE_HTTP_PORT=8003

AGENT_MAX_STEP=30

# API 鉴权(可选):设置后 nginx 自动注入请求头,浏览器无需持 Token;
# 留空 = 不鉴权。公网暴露 / 多人共享时建议设置随机串
API_TOKEN=

# 交易智能体(dsh)上游地址(可选):8093 面板反代目标。
# 默认 http://host.docker.internal:3081(容器经 host-gateway 访问宿主 dsh);
# dsh 在另一台机器时改为 http://<dsh-ip>:3081
DSH_UPSTREAM=http://host.docker.internal:3081

# dsh 访问代理绑定 IP(可选):默认 172.17.0.1(docker 网关,前端 8093 经此代理到 dsh);
# 局域网共享 dsh 时设为本机局域网 IP(如 192.168.31.68)
# DSH_BIND_IP=192.168.31.68