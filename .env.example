# ============ Quant-Agent-Trader 环境变量 ============
# 用法：cp .env.example .env 后按需填写（.env 不入库）。
# 最少配一个模型 Key 即可完整跑通回放/模拟盘；实盘链路见对应小节。

# ---------- 模型 API（至少一组；DeepSeek 注册即用） ----------
OPENAI_API_BASE=""
OPENAI_API_KEY=""
GLM_API_BASE=""
GLM_API_KEY=""
DEEPSEEK_API_KEY=""
# 主模型配额耗尽（Token Insufficient/错误码13）时自动降级到备用模型（deepseek↔glm）
# FALLBACK_LLM_MODEL=glm

# ---------- 资讯/数据（可选；不填则相关搜索/数据工具降级） ----------
JINA_API_KEY=""
ALPHAVANTAGE_API_KEY=""
TUSHARE_TOKEN=""

# ---------- 服务端口（默认即可；与 docker-compose 端口映射保持一致） ----------
MATH_HTTP_PORT=8000
SEARCH_HTTP_PORT=8001
TRADE_HTTP_PORT=8002
GETPRICE_HTTP_PORT=8003

AGENT_MAX_STEP=30

# ---------- API 鉴权（可选但公网强烈建议） ----------
# 设置后 nginx 自动注入请求头，浏览器无需持 Token；留空 = 不鉴权
API_TOKEN=

# ---------- 交易智能体（dsh） ----------
# 8093 面板反代目标；默认 host.docker.internal:3081（容器经 host-gateway 访问宿主 dsh）
DSH_UPSTREAM=http://host.docker.internal:3081
# dsh 访问代理绑定 IP（默认 docker 网关，前端可经 8093 代理到 dsh；局域网共享改为本机 IP）
# DSH_BIND_IP=192.168.31.68
# dsh 直连信任地址（dsh 拒绝绑 0.0.0.0，需显式信任入口）
# DSH_HOST=192.168.31.68

# ---------- A股实盘（可选）：通达信桥（Windows 交易机） ----------
# 桥安装 3 步见 brokers/tdx-bridge/README.md；没有桥也能完整跑模拟盘
TDX_BRIDGE_URL=""
TDX_BRIDGE_TOKEN=""
# 券商资金账号可留空（桥 resolve 默认账户）；TDX_ACCOUNT_TYPE=stock
TDX_ACCOUNT=""
TDX_ACCOUNT_TYPE=stock
# 通达信 AI 数据目录（TDX 客户端本地服务数据，可选）
# TDX_AIDATA_DIR=""

# ---------- 港股实盘（可选）：富途 OpenD ----------
# FUTU_OPEND_HOST=127.0.0.1
# FUTU_OPEND_PORT=11111
# FUTU_RSA_KEY=
# FUTU_TRD_PWD=

# ---------- 美股实盘（可选）：盈透 IBKR Gateway（docker compose --profile ibgateway） ----------
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002
# IBKR_CLIENT_ID=1
# IBKR_USERNAME=
# IBKR_PASSWORD=
# IBKR_TRADING_MODE=paper

# ---------- 美股/港股（可选）：老虎 OpenAPI ----------
# TIGEROPEN_TIGER_ID=
# TIGEROPEN_ACCOUNT=
# TIGEROPEN_PRIVATE_KEY=
# TIGEROPEN_IS_PAPER=true

# ---------- QuantMind 数据平台（可选增强：quantdb 因子/L2/复盘报告） ----------
# QM_API_BASE=
# QM_ADMIN_USER=
# QM_ADMIN_PASSWORD=
# QM_PG_HOST=
# QM_PG_PORT=
# QM_PG_USER=
# QM_PG_PASSWORD=
# QM_PG_DB=
# QM_QUANTDB_DATA_DIR=
# QUANTMIND_DATA_DIR=

# ---------- 其他（可选） ----------
# 盘中分析等调用的附加密钥若放在 .service.env（同 .env 格式，gitignore 内），
# 容器 env_file 会自动读取：DEEPSEEK_API_KEY 等可只放那里，避免与人共享 .env
