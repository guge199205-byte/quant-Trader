config/broker_market.json
data/us_picks.json

# PyneCore 运行时自动生成的脚本配置（inputs 元数据，随脚本重生成）
backend/services/lab_strategies/*.toml

# 批量回测结果（每池一份，几百 KB，跑批产物不入库；界面直接读本地文件）
data/lab_batch/

# Pine 策略库（桌面语料索引 + 重爬副本 + 界面编辑，运行时产物不入库）
data/pine_library/

# .pine → Pyne-Python 转写产物（候选脚本 / 提示词 / 回测报告，运行时产物不入库）
data/pine_transpile/

# 转写链路抽样审计（样本清单 + 汇总报告，运行时产物不入库）
data/pine_audit/

# 事件流（买回/解禁等，每日生成 parquet，体量大且可重生成）
data/events/

# 新闻管线运行时产物（六段 agent 每轮刷新：latest/history/lessons/reviews）
data/news_brief/

# IB Gateway 运行时状态（jts.ini / 启动日志，含会话痕迹不入库）
data/ibgateway-jts/

# 盘中风险封锁清单（每日生成，带 generated_at）
data/risk_block.json

# 一次性手工备份（*.bak-YYYYMMDD）
scripts/*.bak-*

# arena 本地 dev 配置（非仓库正式配置，用完即删）
arena/vite.config.local.ts
