# 生产构建覆盖（Vite 的 .env.production 优先于 .env）
#
# 为什么留空：getBaseUrl() 的优先级链是
#   dynamicServerUrl → localStorage → VITE_API_BASE_URL → [Electron]127.0.0.1:8000 → API_BASE
# 浏览器环境下把 VITE_API_BASE_URL 留空 ⇒ API_BASE='' ⇒ getBaseUrl() 返回 ''
# ⇒ **相对路径同源请求**，由本容器的 nginx 把 /api /health /ws 代理到 quantmind 网关。
#
# ⚠️ 原 .env 里是 http://192.168.31.68:8099（它自己的 dev 端口）——那是给 Vite dev 用的，
#    打生产包若沿用会连到 8099 而打不开。这里显式覆盖为空。
VITE_API_BASE_URL=

# 登录门：保持默认（开启）。若要用"打开即看"，改成 true。
# 注意：关掉只是跳过登录界面，数据接口仍会 401（后端确实要鉴权）。
VITE_DISABLE_AUTH=false
